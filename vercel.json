{
  "version": 2,
  "crons": [
    {
      "path": "/api/generate-daily-book",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/auto-tasks",
      "schedule": "5 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}